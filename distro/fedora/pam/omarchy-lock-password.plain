#%PAM-1.0
# omarchy-lock-password, variant "plain": written by tinkero-pam-sync because this host's
# password-auth already runs pam_faillock. Do not edit; run `sudo tinkero-pam-sync` after
# changing authselect features. Design spec 4.8.
#
# The Quickshell lock runs only the auth phase, so pam_faillock's reset-on-success (which on a
# with-faillock host lives in password-auth's `account` phase) never runs under the lock.
# password-auth is pulled in with `substack` so that a trailing authsucc can clear the tally on
# success: `success=ok` lets the successful substack fall through to authsucc, which reads the
# host's /etc/security/faillock.conf so it clears the same tally file password-auth counts into.
# A wrong password is recorded once by password-auth's own faillock and then dies before
# authsucc, so it is never double-counted (issue #29).
auth     [success=ok default=die]  substack  password-auth
auth     required                  pam_faillock.so authsucc
account  include                   password-auth
