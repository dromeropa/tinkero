#!/bin/bash
# gate-dropped-refs DEST DROPLIST ALLOW: nothing in the payload may still call a
# command that build/drop.list removed, or source a file that is gone (dropped by name or
# otherwise). Findings are "path:command" or "path:usr/share/omarchy/...".
set -euo pipefail
export LC_ALL=C
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd); # shellcheck source=ci/lib-gate.sh
source "$here/lib-gate.sh"
[[ $# -eq 3 ]] || { echo "usage: gate-dropped-refs DEST DROPLIST ALLOW" >&2; exit 2; }
dest=$1; droplist=$2; allow=$3
[[ -d $dest/usr/bin ]] || { echo "FAIL: no payload at DEST (run ./dev payload first)"; exit 2; }
[[ -f $droplist && -r $droplist ]] || { echo "FAIL: cannot read drop list: $droplist"; exit 2; }
found=$(mktemp); trap 'rm -f "$found"' EXIT
# Dropped command names = bin/ lines of the drop list that no longer exist in the payload.
# Globs are expanded against what is NOT there by listing names from the line itself when
# it has no glob, and by skipping glob lines (their members are caught by name below).
binlines=$(grep -E '^bin/' "$droplist" || true)
badglob=$(grep '[?[]' <<<"$binlines" || true)
if [[ -n $badglob ]]; then
  echo "FAIL: unsupported glob in drop list line: $(head -n1 <<<"$badglob") (only * is supported)"
  exit 2
fi
names=$(grep -v '[*?[]' <<<"$binlines" | sed 's|^bin/||' | sort -u || true)
globs=$(grep '[*?[]' <<<"$binlines" | sed 's|^bin/||' || true)
: > "$found"
if [[ -n $names ]]; then
  alt=$(paste -sd'|' <<<"$names")
  ( cd "$dest" && grep -rIoHE "(^|[^a-z0-9-])($alt)([^a-z0-9-]|\$)" . 2>/dev/null \
      | sed -E 's|^\./||; s/^([^:]+):[^a-z]*([a-z0-9-]+).*$/\1:\2/' ) >> "$found" || true
fi
while IFS= read -r g; do
  [[ -z $g ]] && continue
  re=${g//\*/[a-z0-9-]*}
  ( cd "$dest" && grep -rIoHE "(^|[^a-z0-9-])($re)([^a-z0-9-]|\$)" . 2>/dev/null \
      | sed -E 's|^\./||; s/^([^:]+):[^a-z]*([a-z0-9-]+).*$/\1:\2/' ) >> "$found" || true
done <<<"$globs"
# Sourced files: a `source`/`.` line whose target is a literal path under $OMARCHY_PATH,
# ${OMARCHY_PATH}, or /usr/share/omarchy must exist in the payload, even when nothing dropped it
# by name (a helper the drop list removed but a script still sources fails at run time, not at
# gate time). The optional quote after the prefix handles the "$OMARCHY_PATH"/rest.sh idiom
# (variable quoted, literal continuation bare); the capture stops at whitespace, a quote, or
# shell punctuation that ends a command (; & | ) } `) so it does not swallow what follows a
# source line on the same line, and it must start with "/" so a different name that merely
# starts with the same letters ($OMARCHY_PATHX, $OMARCHY_PATH_DIR) is not read as a continuation
# of this one. An empty suffix (a bare $OMARCHY_PATH with nothing after it, or one of those
# unrelated names) and a target that is not fully literal (a variable anywhere in it, e.g.
# "$OMARCHY_PATH/$theme/init.sh") are both skipped rather than checked: for the variable case,
# capturing still runs to the end of the token, and a "$" left in it means guessing what it
# resolves to would be wrong. Known gaps, left for a follow-up since they do not fire on the real
# tree today: only the first source on a line is seen, and a source inside a trailing "# ..."
# comment is not excluded.
# shellcheck disable=SC2016  # the $ signs below are ERE literals for a source line's target, not shell expansions
srcre='(^|[^A-Za-z0-9_.])(source|\.)[[:space:]]+["'"'"']?(\$OMARCHY_PATH|\$\{OMARCHY_PATH\}|/usr/share/omarchy)["'"'"']?(/[^"'"'"'[:space:];&|)}`]*)?'
# shellcheck disable=SC2016  # same literal $ as above, in the grep pattern piped into the loop
while IFS= read -r line; do
  [[ -z $line ]] && continue
  file=${line%%:*}; file=${file#./}
  content=${line#*:}; content=${content#*:}
  [[ $content =~ ^[[:space:]]*# ]] && continue
  [[ $content =~ $srcre ]] || continue
  suffix=${BASH_REMATCH[4]}
  [[ -z $suffix || $suffix == *'$'* ]] && continue
  target="usr/share/omarchy$suffix"
  [[ -f "$dest/$target" ]] || echo "$file:$target" >> "$found"
done < <(cd "$dest" && grep -rnIE '(^|[^A-Za-z0-9_.])(source|\.)[[:space:]]+["'"'"']?(\$OMARCHY_PATH|\$\{OMARCHY_PATH\}|/usr/share/omarchy)' . 2>/dev/null || true)
sort -u -o "$found" "$found"
compare_with_allowlist "$found" "$allow" "references to dropped commands or sourced files"
