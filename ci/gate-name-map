#!/bin/bash
# gate-name-map DEST PKGMAP: every literal package name that the payload passes to
# omarchy-pkg-add, -drop, -present or -missing, directly or through the installers
# omarchy-install-app, -and-launch and -font (in scripts and in the menu's guards and
# actions), must have a row in the name map, and the map must be well-formed and sorted.
# Names reached only through a shell variable are invisible to this gate.
set -euo pipefail
export LC_ALL=C
[[ $# -eq 2 ]] || { echo "usage: gate-name-map DEST PKGMAP" >&2; exit 2; }
dest=$1; map=$2
[[ -d $dest/usr/bin ]] || { echo "FAIL: no payload at $dest (run ./dev payload first)" >&2; exit 2; }
[[ -r $map ]] || { echo "FAIL: cannot read name map: $map" >&2; exit 2; }
if grep -q $'\r' "$map"; then echo "FAIL: name map has CRLF line endings: $map" >&2; exit 2; fi
rc=0

# 1. The map itself: three tab-separated fields, a known kind, sorted, no duplicates.
rows=$(grep -vE '^\s*(#|$)' "$map" || true)
if [[ -z $rows ]]; then echo "FAIL: name map has no rows: $map"; exit 1; fi
bad=$(awk -F'\t' 'NF != 3 || $2 !~ /^(dnf|flatpak|none)$/ || $1 == "" || $3 == "" { print NR": "$0 }' <<<"$rows")
if [[ -n $bad ]]; then echo "FAIL: malformed name map rows:"; printf '  %s\n' "${bad//$'\n'/$'\n'  }"; rc=1; fi
names=$(cut -f1 <<<"$rows")
if [[ $(sort -u <<<"$names") != "$(sort <<<"$names")" ]]; then echo "FAIL: duplicate names in the name map"; rc=1; fi
if [[ $(sort <<<"$names") != "$names" ]]; then echo "FAIL: name map is not sorted by name (LC_ALL=C sort)"; rc=1; fi

# 2. Names used by the payload. Comment lines (shell # and JS //) are skipped and
#    "N>/dev/null" redirections are removed before matching.
q="'[^']*'|\"[^\"]*\""            # a quoted argument
w="[A-Za-z0-9._+@:-]+"           # a bare package name
lines() {
  grep -rhE "omarchy-(pkg-(add|drop|present|missing)|install-(app|and-launch|font)) +[\"'A-Za-z0-9._+@:\$-]" \
    "$dest/usr/bin" "$dest/usr/share/omarchy" 2>/dev/null | grep -vE '^\s*(#|//)' | sed -E 's#[0-9]+>/dev/null##g' || true
}
used=$( {
  # direct wrapper calls: every argument, quotes allowed around a name
  lines | grep -oE "omarchy-pkg-(add|drop|present|missing)( +($q|$w))+" | sed -E 's/^omarchy-pkg-[a-z]+ +//' || true
  # installers: the second argument is the package list; the first is a display name
  lines | grep -oE "omarchy-install-(app|and-launch|font) +($q|[^ ]+) +($q|$w)" \
    | sed -E "s/^omarchy-install-[a-z-]+ +($q|[^ ]+) +//" || true
} | tr -d "\"'" | tr ' ' '\n' | grep -vE '^([0-9]+)?$' | grep -v '^\$' | sort -u || true)
missing=$(comm -23 <(printf '%s\n' "$used") <(sort <<<"$names"))
if [[ -n $missing ]]; then echo "FAIL: package names used by the payload with no row in $map:"; printf '  %s\n' "${missing//$'\n'/$'\n'  }"; rc=1; fi

[[ $rc -eq 0 ]] && echo "PASS: name map covers $(grep -c . <<<"$used") package name(s) used by the payload"
exit $rc
